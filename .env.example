# Model paths (GGUF files) — see scripts/download_models.py to fetch them.
# Leave unset / use LLM_DRIVER=mock and EMBEDDER=mock to run with zero downloads.
LLM_DRIVER=mock
LLM_MODEL_PATH=data/models/Qwen_Qwen3-8B-Q6_K.gguf
LLM_CONTEXT_WINDOW=8192
LLM_GPU_LAYERS=-1

EMBEDDER=mock
EMBEDDING_MODEL_PATH=data/models/nomic-embed-text-v2-moe.Q8_0.gguf
# Embedding offloads no layers to GPU by default — the embedding model is tiny
# (nomic-embed-text-v2-moe: 72M active params) and runs fast on CPU alone.
# Keeping GPU layers dedicated to the LLM avoids device-level contention between
# two Llama instances, so embedding can pre-index files for Chat B while Chat A
# is still mid-generation.
EMBEDDING_GPU_LAYERS=0

# Vector index backend: "flat" (float32, exact) or "quantized" (int8 scalar quant)
VECTOR_INDEX_BACKEND=flat

# Retrieval
RETRIEVAL_TOP_K=5
# Calibrated against nomic-embed-text-v2-moe, not a guess: on the project's
# own test PDF, irrelevant queries topped out at ~0.20 cosine similarity,
# while genuinely relevant matches (including cross-lingual English-query-
# on-French-document) started at ~0.28. 0.22 sits with margin in that gap.
# Recalibrate if you switch embedders — see ARCHITECTURE.md.
RETRIEVAL_MIN_SIMILARITY=0.22

# Storage
DATABASE_PATH=data/keepr.db
INDEX_DIR=data/index
UPLOAD_DIR=data/uploads

# Memory tier override — leave unset to auto-detect from available RAM/VRAM
MEMORY_TIER=

LOG_LEVEL=INFO
