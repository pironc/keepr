# Model paths (GGUF files) — models/ is the default location (MODELS_DIR); drop
# any llama.cpp-compatible GGUF there and pick it in the Settings menu — the choice
# is saved to MODEL_SELECTION_PATH (data/model_selection.json) and applies on the
# next restart. Set *_MODEL_PATH explicitly to override the Settings-menu selection.
# Models can also be fetched straight from the Settings menu, or via
# `python scripts/download_models.py` — both always available, no extra install step.
LLM_DRIVER=mock
# Models directory scanned for .gguf files (default: models)
MODELS_DIR=models
# Where the Settings-menu model selection is persisted (default: data/model_selection.json)
# MODEL_SELECTION_PATH=data/model_selection.json
# LLM_MODEL_PATH=models/Qwen_Qwen3-8B-Q6_K.gguf
LLM_CONTEXT_WINDOW=8192
LLM_GPU_LAYERS=-1

EMBEDDER=mock
# EMBEDDING_MODEL_PATH=models/nomic-embed-text-v2-moe.Q8_0.gguf
# Embedding offloads no layers to GPU by default — the embedding model is tiny
# (nomic-embed-text-v2-moe: 72M active params) and runs fast on CPU alone.
# Keeping GPU layers dedicated to the LLM avoids device-level contention between
# two Llama instances, so embedding can pre-index files for Chat B while Chat A
# is still mid-generation.
EMBEDDING_GPU_LAYERS=0

# Vector index backend: "flat" (float32, exact) or "quantized" (int8 scalar quant)
VECTOR_INDEX_BACKEND=flat

# Retrieval
RETRIEVAL_TOP_K=5
# Calibrated against nomic-embed-text-v2-moe, not a guess: on the project's
# own test PDF, irrelevant queries topped out at ~0.20 cosine similarity,
# while genuinely relevant matches (including cross-lingual English-query-
# on-French-document) started at ~0.28. 0.22 sits with margin in that gap.
# Recalibrate if you switch embedders — see ARCHITECTURE.md.
RETRIEVAL_MIN_SIMILARITY=0.22

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Storage
DATABASE_PATH=data/keepr.db
INDEX_DIR=data/index
UPLOAD_DIR=data/uploads

# Memory tier override — leave unset to auto-detect from available RAM/VRAM
MEMORY_TIER=

LOG_LEVEL=INFO
